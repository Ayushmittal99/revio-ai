ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=5
MAX_ROWS=5000
# auto | heuristic | transformer  (heuristic = offline, no model download)
SENTIMENT_MODE=auto
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# Optional LLM drafting (OpenAI-compatible API). Disabled by default.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=your-key-here
